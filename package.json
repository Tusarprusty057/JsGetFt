{
  "name": "fittribe2",
  "version": "1.0.0",
  "description": "Comprehensive AI-powered fitness tracking application",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "install-all": "npm install && cd client && npm install",
    "init-db": "node server/scripts/initDatabase.js",
    "seed": "node server/seeders/seedDatabase.js",
    "seed:dev": "npm run seed && npm run dev",
    "setup": "npm run install-all && npm run init-db && npm run seed"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "mongoose": "^7.5.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "cloudinary": "^1.40.0",
    "axios": "^1.5.0",
    "socket.io": "^4.7.2",
    "node-cron": "^3.0.2",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.10.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.0"
  },
  "keywords": ["fitness", "ai", "health", "tracking", "nutrition", "workout"],
  "author": "FitTribe Team",
  "license": "MIT"
}
